{
  "info": {
    "name": "Helmet Security Headers Demo",
    "description": "Test Helmet's default security headers and strict rate limiting",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Helmet Headers Demo",
      "item": [
        {
          "name": "View All Helmet Headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test that response is successful",
                  "pm.test('Response is 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Log all security headers Helmet sets",
                  "console.log('=== HELMET SECURITY HEADERS ===');",
                  "",
                  "// X-DNS-Prefetch-Control: Controls browser DNS prefetching",
                  "const dnsPrefetch = pm.response.headers.get('X-DNS-Prefetch-Control');",
                  "console.log('X-DNS-Prefetch-Control:', dnsPrefetch || 'Not set');",
                  "pm.test('X-DNS-Prefetch-Control header is set', function() {",
                  "    pm.expect(dnsPrefetch).to.exist;",
                  "});",
                  "",
                  "// X-Frame-Options: Prevents clickjacking attacks",
                  "const frameOptions = pm.response.headers.get('X-Frame-Options');",
                  "console.log('X-Frame-Options:', frameOptions || 'Not set');",
                  "pm.test('X-Frame-Options prevents clickjacking', function() {",
                  "    pm.expect(frameOptions).to.exist;",
                  "});",
                  "",
                  "// X-Content-Type-Options: Prevents MIME-sniffing",
                  "const contentType = pm.response.headers.get('X-Content-Type-Options');",
                  "console.log('X-Content-Type-Options:', contentType || 'Not set');",
                  "pm.test('X-Content-Type-Options prevents MIME sniffing', function() {",
                  "    pm.expect(contentType).to.equal('nosniff');",
                  "});",
                  "",
                  "// X-Download-Options: Prevents file download attacks (IE8+)",
                  "const downloadOptions = pm.response.headers.get('X-Download-Options');",
                  "console.log('X-Download-Options:', downloadOptions || 'Not set');",
                  "",
                  "// X-Permitted-Cross-Domain-Policies: Controls Adobe products access",
                  "const crossDomain = pm.response.headers.get('X-Permitted-Cross-Domain-Policies');",
                  "console.log('X-Permitted-Cross-Domain-Policies:', crossDomain || 'Not set');",
                  "",
                  "// Referrer-Policy: Controls referrer information",
                  "const referrer = pm.response.headers.get('Referrer-Policy');",
                  "console.log('Referrer-Policy:', referrer || 'Not set');",
                  "",
                  "// Strict-Transport-Security: Forces HTTPS connections",
                  "const hsts = pm.response.headers.get('Strict-Transport-Security');",
                  "console.log('Strict-Transport-Security:', hsts || 'Not set (HTTPS only)');",
                  "",
                  "// X-XSS-Protection: XSS filter for older browsers",
                  "const xss = pm.response.headers.get('X-XSS-Protection');",
                  "console.log('X-XSS-Protection:', xss || 'Not set');",
                  "",
                  "// Content-Security-Policy: Prevents XSS and injection attacks",
                  "const csp = pm.response.headers.get('Content-Security-Policy');",
                  "console.log('Content-Security-Policy:', csp || 'Not set');",
                  "",
                  "console.log('================================');",
                  "console.log('TIP: Check the \"Headers\" tab in Postman to see all headers!');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/helmet-demo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "helmet-demo"]
            },
            "description": "Tests a simple endpoint to view all security headers that Helmet adds by default. Check the console and Headers tab to see all security headers."
          },
          "response": []
        }
      ],
      "description": "Demonstrates Helmet's default security headers"
    },
    {
      "name": "2. Strict Rate Limiting (1 req/min)",
      "item": [
        {
          "name": "First Request - Should Succeed",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('First request succeeds', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains success message', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.message).to.include('Success');",
                  "});",
                  "",
                  "console.log('First request succeeded. Now try the second request immediately...');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/strict-limit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "strict-limit"]
            },
            "description": "First request to the strictly rate-limited endpoint. This should succeed."
          },
          "response": []
        },
        {
          "name": "Second Request - Should Fail (Rate Limited)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Second request is rate limited', function() {",
                  "    pm.response.to.have.status(429);",
                  "});",
                  "",
                  "pm.test('Error message explains rate limit', function() {",
                  "    const response = pm.response.text();",
                  "    pm.expect(response).to.include('Only 1 request per minute');",
                  "});",
                  "",
                  "// Check for rate limit headers",
                  "const retryAfter = pm.response.headers.get('Retry-After');",
                  "const remaining = pm.response.headers.get('X-RateLimit-Remaining');",
                  "",
                  "console.log('Rate limit hit!');",
                  "console.log('X-RateLimit-Remaining:', remaining);",
                  "console.log('Retry-After:', retryAfter, 'seconds');",
                  "console.log('Wait 60 seconds and try again to succeed.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/strict-limit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "strict-limit"]
            },
            "description": "Second request sent immediately after the first. This should fail with 429 Too Many Requests because the endpoint only allows 1 request per minute."
          },
          "response": []
        }
      ],
      "description": "Tests the strict rate limiter that only allows 1 request per minute"
    },
    {
      "name": "3. Standard Rate Limiting (100 req/12hr)",
      "item": [
        {
          "name": "Test Standard Rate Limit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Request succeeds under normal rate limit', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Check rate limit headers",
                  "const limit = pm.response.headers.get('X-RateLimit-Limit');",
                  "const remaining = pm.response.headers.get('X-RateLimit-Remaining');",
                  "const reset = pm.response.headers.get('X-RateLimit-Reset');",
                  "",
                  "console.log('=== STANDARD RATE LIMIT INFO ===');",
                  "console.log('X-RateLimit-Limit:', limit, 'requests per window');",
                  "console.log('X-RateLimit-Remaining:', remaining, 'requests left');",
                  "console.log('X-RateLimit-Reset:', new Date(reset * 1000).toISOString());",
                  "console.log('You can make', remaining, 'more requests in the next 12 hours.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/helmet-demo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "helmet-demo"]
            },
            "description": "Tests the standard rate limiter applied to all /api routes (100 requests per 12 hours). Check console to see how many requests you have remaining."
          },
          "response": []
        }
      ],
      "description": "Tests the standard API rate limiter"
    }
  ]
}
