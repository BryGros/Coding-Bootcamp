{
  "name": "shopping-cart-api",
  "version": "1.0.0",
  "description": "A shopping cart API using Express, MongoDB and Mongoose",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "newman run Shopping-Cart-API.postman_collection.json",
    "test:verbose": "newman run Shopping-Cart-API.postman_collection.json --reporters cli,json --reporter-json-export testResults.json"
  },
  "keywords": [
    "mongodb",
    "mongoose",
    "express",
    "api",
    "shopping-cart"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "mongoose": "^7.0.0"
  },
  "devDependencies": {
    "newman": "^6.2.1",
    "nodemon": "^3.0.1"
  }
}
