# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/auth-demo

# JWT Configuration
# IMPORTANT: Change these to strong, random strings in production
# You can generate secure secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production

# Token expiration times
# Access tokens should be short-lived (15 minutes)
JWT_EXPIRE=15m
# Refresh tokens can be longer-lived (7 days)
JWT_REFRESH_EXPIRE=7d

# Bcrypt Configuration
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
